# Copy to .env.local and fill in. Never commit real values.
# Leave both empty to run in guest-only mode (no accounts).
# Supabase dashboard → Project Settings → API Keys (use the "publishable" key, sb_publishable_...).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: a paid TheSportsDB key (live cricket and rugby scores). Defaults to the free key.
THESPORTSDB_KEY=
